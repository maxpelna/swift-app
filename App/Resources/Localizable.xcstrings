    "onboardingDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app is built with Swift to demonstrate my approach of using technology as end of 2025. It follows clean architecture principles with unidirectional data flow, custom MVI for state management approach that is inherited from BLoC. More in README. Open source API: https://rickandmortyapi.com"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta app está creada con Swift para demostrar mi enfoque del uso de la tecnología a finales de 2025. Sigue principios de arquitectura limpia con flujo de datos unidireccional y un MVI personalizado para la gestión del estado, heredado de BLoC. Más información en el README. API de código abierto: https://rickandmortyapi.com"
          }
        }
      }
    },
